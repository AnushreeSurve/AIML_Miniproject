# ---- Data: DRCR terms forbid redistribution. Only synthetic data is committed.
data/*
!data/synthetic/
!data/synthetic/**
# DVC pointer files (hash + size only, no data)
!data/*.dvc

# ---- Generated artefacts
models/*
!models/.gitkeep
mlruns/
mlflow.db
logs/
*.joblib

# ---- Credentials
kaggle.json
.kaggle/
.env

# ---- Python / tooling
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.ipynb_checkpoints
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# ---- Generated report outputs (regenerate with `python -m equipoise all` / `dvc repro`).
# Real-data figures include patient-level points; the team decides what goes in the report.
reports/figures/*
reports/tables/*
reports/synthetic/
!reports/**/.gitkeep
